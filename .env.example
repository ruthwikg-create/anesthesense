# Research workstation login; environment variables must be exported before starting uvicorn.
# Generate a 32+ character random secret, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"
ANESTHESENSE_SESSION_SECRET=
ANESTHESENSE_USERNAME=
# SHA256 hex digest of your chosen password; do not commit the password.
ANESTHESENSE_PASSWORD_SHA256=
# Set true behind HTTPS in deployment; false is local HTTP development only.
ANESTHESENSE_COOKIE_SECURE=false
GEMINI_API_KEY=
